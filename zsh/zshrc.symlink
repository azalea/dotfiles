# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/.dotfiles

# your project folder that we can `c [tab]` to
export PROJECTS=~/Dropbox/Projects

# gem path, for jekyll
# heraku
# lavarel
export GEM_HOME=$HOME/gems
export PATH=$HOME/gems/bin:/usr/local/heroku/bin:$HOME/.composer/vendor/bin:$PATH

# use .localrc for SUPER SECRET CRAP that you don't
# want in your public, versioned repo.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

# Aliases
alias python=python3.11
alias kimmy='ssh -L 3389:kimmy:3389 zhaorong@gitlab.softgenetics.com -N'
alias coco='ssh -L 3389:Coco:3389 zhaorong@gitlab.softgenetics.com -N'
alias ruby='ssh -L 8890:192.168.1.193:3389 zhaorong@gitlab.softgenetics.com -N'
